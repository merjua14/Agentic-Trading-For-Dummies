# Copy to .env and fill in. Never commit .env.
# This tutorial is paper-only. Do not add a live switch.

# anthropic | openai | xai
PROVIDER=anthropic

# claude-opus-4-6 | gpt-5.6-sol | grok-4
MODEL=claude-opus-4-6

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# Liquid connector URL and token. The runner will tell the model to use paper mode.
LIQUID_MCP_URL=
LIQUID_MCP_TOKEN=

# Two looks per run is enough for a first paper pass. Raise later if you want.
SUBTICKS=2
SUBTICK_SECONDS=300

RULEBOOK=../rulebook/liquid-v77-lite.txt
LEDGER=./ledger.csv
