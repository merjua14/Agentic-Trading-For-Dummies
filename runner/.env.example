# Copy to .env and fill in. Never commit .env.
# This tutorial is paper-only. Do not add a live switch.
# Fill the three lines in the README. Leave every other line alone.
# No quotes. No spaces around the = sign.

# Which model company. Keep anthropic unless your key is from OpenAI or xAI.
# anthropic | openai | xai
PROVIDER=anthropic

# Must match PROVIDER. claude-opus-4-6 | gpt-5.6-sol | grok-4
MODEL=claude-opus-4-6

# Paste your key on ONE line. Leave the other two empty.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# From your Liquid connector. Liquid is the exchange app. Keep it in paper mode.
LIQUID_MCP_URL=
LIQUID_MCP_TOKEN=

# Two looks per run is enough for a first paper pass.
SUBTICKS=2
# Stored only. This runner does not pause between looks.
SUBTICK_SECONDS=300

RULEBOOK=../rulebook/liquid-v77-lite.txt
LEDGER=./ledger.csv
